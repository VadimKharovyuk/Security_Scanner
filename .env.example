# Образец локальных настроек. Приложение этот файл не читает.
# Скопируйте его в .env и заполните значения: .env не попадает в git.

# Пароль локальной базы PostgreSQL.
DB_PASSWORD=

# Случайное значение: openssl rand -hex 32
ZAP_API_KEY=

# true включает сканер ZAP: каждое сканирование будет обходить страницы актива.
ZAP_ENABLED=false

# Порты своего проекта на localhost, которые разрешено сканировать (через запятую). Пусто — localhost запрещён.
SCAN_LOCAL_PORTS=

# Ключ OpenRouter для AI-анализа. Находки сканирования передаются провайдеру модели.
OPENROUTER_API_KEY=
